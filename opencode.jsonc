{
  "$schema": "https://opencode.ai/config.json",

  // A projekt szabályai az AGENTS.md-ben élnek – az OpenCode automatikusan betölti,
  // a Claude Code pedig v2.1.277+ óta szintén olvassa, így nincs szükség külön CLAUDE.md-re.
  // Ugyanaz a lista, mint a Claude Code helyi engedélyeiben
  // (.claude/settings.local.json), csak verziózva, hogy mindenkinél működjön.
  // Ha egy parancsra egyik szabály sem illik, az OpenCode rákérdez.
  "permissions": [
    { "action": "shell", "resource": "git *", "effect": "allow" },
    { "action": "shell", "resource": "python *", "effect": "allow" },
    { "action": "shell", "resource": "python3 *", "effect": "allow" },
    { "action": "shell", "resource": "node *", "effect": "allow" },
    { "action": "shell", "resource": "uv run *", "effect": "allow" },

    // Az AGENTS.md kérése: ne push-olj automatikusan – ehhez kérjen jóváhagyást.
    { "action": "shell", "resource": "git push*", "effect": "ask" }
  ]
}
